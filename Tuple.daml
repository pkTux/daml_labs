module Tuple where
import Daml.Script
import DA.Tuple
import DA.List


testTuples : Script ()
testTuples = script do
    let
        song = [("do", "a deer, a female deer"), ("re", "a drop of golden sun"), ("mi", "a name, I call myself"), ("fa", "a long long way to run")]

    debug $ show ( fst (head song),fst (song !! 1), fst (song !! 2))
    debug $ show (filter (\(note, _) -> note == "do") song, filter (\(note, _) -> note == "re") song, filter (\(note, _) -> note == "mi") song, filter (\(note, _) -> note == "fa") song)
    debug $ show (lookup "do" song)
