module TupleTest where
import Daml.Script
--import DA.Tuple
import DA.List as List
import DA.Map as Map
import DA.Text as Text
--import DA.Numeric
--import DA.Optional (fromSome)

testTuple : Script ()
testTuple = script do
    let
        myMap : Map Text Text
        myMap = Map.empty
    debug $ "map:" <> show myMap

    let
        song = [("do", "a deer, a female deer"), ("re", "a drop of golden sun"), ("mi", "a name, I call myself"), ("fa", "a long long way to run")]
        myMap = Map.fromList song
        firstElement = head song
        firstNote = fst firstElement
        secondElement = song !! 1
        secondNote = fst secondElement
        thirdElement = song !! 2    
        thirdNote = fst thirdElement    
        fourthElement = song !! 3
        fourthNote = fst fourthElement
     

    debug $ Map.lookup "do" myMap
    debug $ Map.lookup "re" myMap
    debug $ Map.lookup "mi" myMap
    debug $ Map.lookup "fa" myMap
    debug $ "Notes" <> show ( fst (head song),fst (song !! 1), fst (song !! 2), fst (song !! 3))
    debug $ "Lyrics" <> show (snd firstElement, snd secondElement, snd thirdElement, snd fourthElement)
    debug $ "Reversed Notes" <> show (fourthNote, thirdNote, secondNote, firstNote)
    debug $ "Reversed Lyrics" <> show (snd fourthElement, snd thirdElement, snd secondElement, snd firstElement)
